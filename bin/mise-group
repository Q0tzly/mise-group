#!/bin/bash
# Enable/disable groups of mise tools.
#
# A group is a TOML file of [tools] in the groups directory. A group is
# enabled when ~/.config/mise/conf.d/<name>.toml links to its file, so the
# enabled set needs no state file of its own: files that are only listed in
# the groups directory are a catalog of tools you may install later, and
# nothing is installed until a group is enabled.
#
# Groups directory resolution, first match wins:
#   1. $MISE_GROUPS_DIR
#   2. <repo>/mise/groups   (legacy layout, groups kept inside a dotfiles repo)
#   3. ~/.config/mise/groups
# The conf.d directory can be overridden with $MISE_CONF_D.
set -euo pipefail

SELF="$0"
[[ -L "$SELF" ]] && SELF="$(readlink "$SELF")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
if [[ -n "${MISE_GROUPS_DIR:-}" ]]; then
  GROUPS_DIR="$MISE_GROUPS_DIR"
elif [[ -d "$ROOT/mise/groups" ]]; then
  GROUPS_DIR="$ROOT/mise/groups"
else
  GROUPS_DIR="$HOME/.config/mise/groups"
fi
# mise also reads ./mise/config.toml as a project config, so never run from a repo.
cd "$HOME"
CONF_D="${MISE_CONF_D:-$HOME/.config/mise/conf.d}"

usage() {
  cat <<USAGE
usage: mise-group list
       mise-group enable [--no-install] <group>...
       mise-group disable <group>...
       mise-group names

Groups are TOML files in $GROUPS_DIR
(set MISE_GROUPS_DIR to use another directory).
USAGE
  exit 1
}

group_file() {
  local f="$GROUPS_DIR/$1.toml"
  [[ -f "$f" ]] || { echo "unknown group: $1 (see: mise-group list)" >&2; exit 1; }
  echo "$f"
}

is_enabled() { [[ -L "$CONF_D/$1.toml" ]]; }

# Tool names are the keys under [tools].
tools_of() {
  sed -nE 's/^("[^"]+"|[A-Za-z0-9_.:@\/-]+)[[:space:]]*=.*/\1/p' "$1" | tr -d '"'
}

require_groups_dir() {
  [[ -d "$GROUPS_DIR" ]] || {
    echo "no groups directory: $GROUPS_DIR" >&2
    echo "create it and put <group>.toml files there, or set MISE_GROUPS_DIR." >&2
    exit 1
  }
}

all_groups() {
  local f
  require_groups_dir
  for f in "$GROUPS_DIR"/*.toml; do
    [[ -e "$f" ]] || continue
    basename "$f" .toml
  done
}

cmd_list() {
  local g mark
  require_groups_dir  # in this shell: a failure inside $(all_groups) would be lost
  for g in $(all_groups); do
    is_enabled "$g" && mark="[x]" || mark="[ ]"
    printf '%s %-12s %s\n' "$mark" "$g" "$(tools_of "$GROUPS_DIR/$g.toml" | tr '\n' ' ')"
  done
}

cmd_enable() {
  local install=1 g
  if [[ "${1:-}" == --no-install ]]; then install=0; shift; fi
  [[ $# -gt 0 ]] || usage
  for g in "$@"; do group_file "$g" >/dev/null; done  # validate all before touching anything
  mkdir -p "$CONF_D"
  for g in "$@"; do
    ln -sfn "$GROUPS_DIR/$g.toml" "$CONF_D/$g.toml"
    echo "enabled $g"
  done
  if [[ $install -eq 1 ]]; then mise install --yes; fi
}

cmd_disable() {
  local g tool
  [[ $# -gt 0 ]] || usage
  for g in "$@"; do
    local file
    file="$(group_file "$g")"
    rm -f "$CONF_D/$g.toml"
    echo "disabled $g"
    # Only remove tools that no remaining config still lists.
    while IFS= read -r tool; do
      if mise ls --json "$tool" 2>/dev/null | grep -q '"source"'; then
        echo "  keep $tool (used by another config)"
      else
        mise uninstall --all "$tool" >/dev/null 2>&1 && echo "  removed $tool" || true
      fi
    done < <(tools_of "$file")
  done
}

case "${1:-}" in
  list) cmd_list ;;
  enable) shift; require_groups_dir; cmd_enable "$@" ;;
  names) require_groups_dir; all_groups ;;
  disable) shift; require_groups_dir; cmd_disable "$@" ;;
  *) usage ;;
esac
